# Copy to .env and fill in.

# --- Providers ---
# Anthropic: either sign in once with `ant auth login` (recommended) and leave this
# commented out, or set a key. An empty value overrides the sign-in, so don't leave it blank.
# ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# A Cartesia voice id (pick a warm Indian-English / Hindi-capable voice in the Cartesia playground)
CARTESIA_VOICE_ID=

# --- Models (benchmark these for latency; see README) ---
AGENT_MODEL=claude-sonnet-5-5
AGENT_EFFORT=low
# adaptive | between_tools (no thinking, Sonnet 5.5 only)
AGENT_THINKING=adaptive
PROMPT_CACHING=true
# sentence (natural prosody) | token (stream tokens; lone first words get stretched)
TTS_TEXT_MODE=sentence
# Cartesia server-side buffer before speaking (ms). Unset = Cartesia's 3000ms default.
CARTESIA_MAX_BUFFER_MS=400
# Greeting + post-verification reminder from templates (no LLM wait)
TEMPLATED_TURNS=true
SIMULATOR_MODEL=claude-opus-5-5
JUDGE_MODEL=claude-opus-5-5
# flux (turn detection + speculative LLM start) | nova (Nova-3 + Smart Turn)
STT_ENGINE=flux
FLUX_MODEL=flux-general-multi
FLUX_EAGER_EOT_THRESHOLD=0.5
FLUX_EOT_THRESHOLD=0.7
DEEPGRAM_MODEL=nova-3
# "multi" lets Deepgram follow English <-> Hindi code-switching
DEEPGRAM_LANGUAGE=multi

# --- Call behaviour ---
# Background-noise suppression on caller audio: rnnoise | off
NOISE_FILTER=rnnoise
# Save each call's audio to outcomes/recordings/<call_id>.wav
RECORD_CALLS=true
# Cross-call memory (SQLite)
HISTORY_DB=outcomes/history.db
DEFAULT_BORROWER_ID=LF-1001
USER_IDLE_TIMEOUT_SECS=7
# Silence (s) before ending a turn Smart Turn judged incomplete. Pipecat default 3.0.
SMART_TURN_STOP_SECS=1.2
MAX_IDLE_PROMPTS=2

# --- Mock tools (to demo dead-air handling and tool failure recovery) ---
PAYMENT_LINK_DELAY_SECS=2.5
PAYMENT_LINK_FAILURE_RATE=0

# Groq (open-weight model comparison)
GROQ_API_KEY=
CEREBRAS_API_KEY=
